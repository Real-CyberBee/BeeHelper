{
  "manifest_version": 3,
  "name": "BeeHelper",
  "description": "AI 可微调的浏览器微应用工作台",
  "version": "0.5.1",
  "minimum_chrome_version": "138",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "userScripts",
    "nativeMessaging",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 BeeHelper",
    "default_icon": {
      "16": "icons/bee-16.png",
      "32": "icons/bee-32.png",
      "48": "icons/bee-48.png",
      "128": "icons/bee-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/bee-16.png",
    "32": "icons/bee-32.png",
    "48": "icons/bee-48.png",
    "128": "icons/bee-128.png"
  }
}
