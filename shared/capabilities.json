    "readRun": "run_get",
    "retainedRuns": 100,
    "activeMeaning": "脚本已挂载监听或界面，不代表按钮逻辑已执行或业务任务完成",
    "sdk": [
      "log",
      "output",
      "mount",
      "fill",
      "on",
      "observe",
      "cleanup",
      "storage",
      "tabs",
      "apps",
      "askAI"
