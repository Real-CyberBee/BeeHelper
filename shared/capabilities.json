    "supportedGrant": [
      "GM_info",
      "GM_getValue",
      "GM_setValue",
      "GM_deleteValue",
      "GM_listValues",
      "GM_addValueChangeListener",
      "GM_removeValueChangeListener",
      "GM_addStyle",
      "GM_addElement",
      "GM_xmlhttpRequest",
      "GM_notification",
      "GM_setClipboard",
      "GM_openInTab",
      "GM_registerMenuCommand",
